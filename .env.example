# EduKhata web (apps/web)
NEXT_PUBLIC_SITE_URL=http://localhost:3200
NEXT_PUBLIC_ICTSPARK_URL=https://ictspark.online
NEXT_PUBLIC_WAN_HUB_URL=http://localhost:4100
# Demo data banner (marketplace data is still demo data until Phase 4)
NEXT_PUBLIC_DEMO_MODE=true
# wan = real WAN Identity sign-in through apps/api; demo = Phase 1 role picker (no backend)
AUTH_MODE=demo
# Where the Next.js server reaches the API. Also baked into the /api rewrite at build time.
API_INTERNAL_URL=http://127.0.0.1:4200
