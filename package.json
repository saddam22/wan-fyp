{
  "name": "edukhata",
  "private": true,
  "description": "EduKhata \u2014 Assignment & Practical Khata Marketplace (WANBAHJAHKAS ecosystem)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @edukhata/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "e2e": "pnpm --filter @edukhata/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "traceability": "python3 scripts/gen_traceability.py",
    "dev:api": "pnpm --filter @edukhata/api dev",
    "e2e:wan": "pnpm --filter @edukhata/web e2e:wan"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "~6.0.3"
  }
}
