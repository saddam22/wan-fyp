{
  "name": "@edukhata/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EduKhata API: WAN Identity sign-in, sessions, marketplace roles (Fastify 5 + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "grant-role": "tsx --env-file-if-exists=.env src/cli/grant-role.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@agg/calling-server": "workspace:*",
    "@amar/social-modules": "workspace:*",
    "@chat-module/core": "workspace:*",
    "@chat-module/server": "workspace:*",
    "@edukhata/contracts": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "10.3.0",
    "fastify": "5.12.6",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/web-push": "^3.6.4",
    "jose": "6.2.13",
    "typescript": "~6.0.3",
    "vitest": "5.0.4"
  }
}
