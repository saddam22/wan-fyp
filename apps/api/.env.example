# EduKhata API (apps/api). Copy to .env; never commit .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edukhata
PORT=4200
# Public origin of the web app; the API is reached through it at /api.
WEB_URL=http://localhost:3200
# WAN Identity Hub (issuer = <WAN_HUB_URL>/oidc, platform API = <WAN_HUB_URL>/platform-api/v1)
WAN_HUB_URL=http://localhost:4100
EDK_CLIENT_ID=edukhata
# Must equal the hub's EDK_CLIENT_SECRET. 32+ characters. Development has a built-in default.
# EDK_CLIENT_SECRET=
# How often a session re-checks the hub entitlement (seconds).
HUB_CHECK_INTERVAL_SEC=600
# Proxies whose X-Forwarded-For is trusted (the web server). Keep the API off the public internet.
TRUST_PROXY=127.0.0.1,::1,::ffff:127.0.0.1

# --- Chat (WAN chat module) ---
# HMAC secret for chat tokens, upload and attachment URLs (32+ random chars; required in production)
CHAT_SECRET=
# Chat files on disk (single API instance). Use S3-compatible storage before scaling out.
CHAT_UPLOAD_DIR=.data/chat-uploads
