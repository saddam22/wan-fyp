# EduKhata staging. Copy to deploy/.env.staging (never commit it) and fill in.
SITE_DOMAIN=staging.edukhata.example
WEB_URL=https://staging.edukhata.example
WAN_HUB_URL=https://id-staging.wanbahjahkas.example
EDK_CLIENT_ID=edukhata
# Same value as the hub's EDK_CLIENT_SECRET. Generate: openssl rand -base64 48
EDK_CLIENT_SECRET=
# Different random value: openssl rand -base64 48
CHAT_SECRET=
POSTGRES_PASSWORD=
# The web container's network (it sets X-Forwarded-For for the API).
TRUST_PROXY=172.16.0.0/12
NEXT_PUBLIC_SITE_URL=https://staging.edukhata.example
NEXT_PUBLIC_WAN_HUB_URL=https://id-staging.wanbahjahkas.example
NEXT_PUBLIC_DEMO_MODE=false
# Optional
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CALL_STUN_URLS=stun:stun.l.google.com:19302
CALL_TURN_URLS=
CALL_TURN_SECRET=
NEXT_PUBLIC_ADS_URL=
NEXT_PUBLIC_ADS_APP_KEY=
EDK_TAG=staging
